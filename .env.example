# TiDB Cloud Starter (MySQL-compatibel)
# TiDB Cloud console > Connect: host, poort 4000, database en gebruiker.
# De gebruikersnaam bevat altijd het clusterprefix, bijv. "<prefix>.root".
DB_HOST=gateway01.<regio>.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=taxi_de_polder
DB_USER=<prefix>.root
DB_PASSWORD=...
# Het publieke endpoint van TiDB Cloud vereist TLS. De certificaatketen wordt
# tegen de CA-store van Node gevalideerd, inclusief hostnaamcontrole.
DB_SSL=true
# Bewust laag: meerdere serverless instanties op Vercel delen de
# verbindingslimiet van het TiDB Starter-plan.
DB_CONNECTION_LIMIT=3

# Google Maps Platform (Google Cloud project: taxi-de-polder)
# Server only. Key must allow Routes API + Places API (New).
GOOGLE_MAPS_SERVER_API_KEY=AIza...

# Resend (sender domain notify.taxidepolder.nl must be verified)
# Server only.
RESEND_API_KEY=re_...
RESERVATION_FROM_EMAIL="Taxi De Polder <reserveringen@notify.taxidepolder.nl>"
RESERVATION_TO_EMAIL=info@taxidepolder.nl
RESERVATION_REPLY_TO=info@taxidepolder.nl

# Optional: base URL used in e-mail action links (defaults to https://www.taxidepolder.nl)
# APP_URL=https://www.taxidepolder.nl
