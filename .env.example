# Hostinger MySQL
# hPanel > Databases > Management: hostnaam, databasenaam en gebruiker.
# Voor toegang vanaf Vercel moet Remote MySQL aan staan met host "%".
DB_HOST=srvXXX.hstgr.io
DB_PORT=3306
DB_NAME=uXXXXXXXX_taxidepolder
DB_USER=uXXXXXXXX_taxi
DB_PASSWORD=...
# Zet op true zodra Hostinger een geldig TLS-certificaat aanbiedt op de
# remote MySQL-poort. Standaard uit.
DB_SSL=false
# Bewust laag i.v.m. de verbindingslimiet van Hostinger en meerdere
# serverless instanties op Vercel.
DB_CONNECTION_LIMIT=3

# Google Maps Platform (Google Cloud project: taxi-de-polder)
# Server only. Key must allow Routes API + Places API (New).
GOOGLE_MAPS_SERVER_API_KEY=AIza...

# Resend (sender domain notify.taxidepolder.nl must be verified)
# Server only.
RESEND_API_KEY=re_...
RESERVATION_FROM_EMAIL="Taxi De Polder <reserveringen@notify.taxidepolder.nl>"
RESERVATION_TO_EMAIL=info@taxidepolder.nl
RESERVATION_REPLY_TO=info@taxidepolder.nl

# Optional: base URL used in e-mail action links (defaults to https://www.taxidepolder.nl)
# APP_URL=https://www.taxidepolder.nl
